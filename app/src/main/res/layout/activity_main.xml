<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Student Web Portal"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/txtStudent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Name: JOYLYN&#10;USN: 25MCAR0099"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="15dp" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Android Menus and WebView Demonstration"
                android:textSize="18sp"
                android:gravity="center"
                android:padding="15dp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnPopup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN POPUP MENU"
                android:layout_marginTop="25dp" />

            <Button
                android:id="@+id/btnWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPEN WEB PAGE"
                android:layout_marginTop="15dp" />

            <TextView
                android:id="@+id/txtContext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LONG PRESS THIS TEXT FOR CONTEXT MENU"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="25dp"
                android:layout_marginTop="25dp" />

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="500dp"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>